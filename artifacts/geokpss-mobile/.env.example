# GeoKPSS — RevenueCat (App Store & Google Play In-App Purchase) API Anahtarları
# RevenueCat Dashboard -> Project Settings -> API Keys bölümünden alınan Public SDK anahtarlarını buraya girin:
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your_revenuecat_ios_public_sdk_key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your_revenuecat_android_public_sdk_key
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro
